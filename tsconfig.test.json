{
  // Type-checks the tests, which the build's tsconfig.json leaves out so they
  // never land in dist/. `npm test` runs this before the tests themselves.
  "extends": "./tsconfig.json",
  "compilerOptions": { "noEmit": true, "lib": ["ES2022"] },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/client"]
}
