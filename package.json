{
  "name": "weather-dashboard",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc && npm run build:client",
    "build:client": "tsc -p tsconfig.client.json",
    "start": "node dist/server.js",
    "dev": "npm run build:client && ts-node src/server.ts",
    "import": "ts-node src/import.ts",
    "screenshot": "ts-node --transpile-only screenshot.ts",
    "test": "tsc -p tsconfig.test.json && node --require ts-node/register/transpile-only --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "express": "^4.18.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.0",
    "playwright": "^1.61.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2"
  }
}
